# Пример переменных окружения сервиса «Ноготочки».
#
# Быстрый путь:  npm run env:init
#   Команда создаст .env по этому образцу и сама сгенерирует секреты
#   и пароли демонстрационных аккаунтов. Ничего вписывать не нужно.
#
# Ручной путь:   cp .env.example .env  — и заполнить значения самому.
#
# Сам .env в репозиторий не попадает: он перечислен в .gitignore.
# В этом файле значений нет и быть не должно — только имена и пояснения.
#
# --------------------------------------------------------------------
# Что живёт здесь, а что в базе
#
#   Здесь — то, что зависит от машины, и то, что является секретом.
#   Менять это вправе только тот, у кого есть доступ к серверу.
#
#   В таблице settings — правила работы студии: название, адрес, телефон,
#   часовой пояс, длительность резерва, горизонт записи, срок отмены,
#   лимит переносов, шаг сетки времени. Их меняет администратор салона
#   на экране A11, не открывая ни одного файла на сервере.
#
#   Правило простое: если значение вправе менять администратор салона —
#   оно в базе. Если только системный администратор — оно здесь.
# --------------------------------------------------------------------

# --- окружение ---
# development | production
NODE_ENV=
# Порт HTTP-сервера
PORT=

# Откуда странице разрешено обращаться к API (CORS). Список через запятую,
# адреса целиком, со схемой и портом:
#   WEB_ORIGINS=https://nogotochki.ru
#   WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Пусто — межсайтовых запросов нет. Это верное значение, когда статику
# и API отдаёт один домен: тогда разрешение просто не нужно.
# В разработке умолчание — порт раздатчика статики (web/serve.mjs).
WEB_ORIGINS=

# --- база данных ---
# Путь к файлу SQLite относительно папки server/
DATABASE_FILE=
# Куда складывать резервные копии базы (VACUUM INTO по расписанию)
DATABASE_BACKUP_DIR=

# --- секреты (обязательны в любом окружении) ---
# Ключ, которым подписываются хеши токенов сессии. Длинная случайная строка.
# Сгенерировать вручную:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Дополнительный секрет, подмешиваемый к паролю перед хешированием.
# Хранится только здесь, никогда в базе: утечка базы без него бесполезна.
# ВНИМАНИЕ: смена значения делает недействительными все пароли в базе.
PASSWORD_PEPPER=

# --- параметры безопасности ---
# Сколько часов живёт сессия до повторного входа
SESSION_TTL_HOURS=
# Сколько минут живёт ссылка восстановления пароля.
# Здесь, а не в настройках студии: администратору салона незачем и опасно
# двигать этот срок — сутки вместо часа заметно расширяют окно,
# в котором утёкшее письмо ещё пускает в аккаунт.
PASSWORD_RESET_TTL_MINUTES=

# --- ограничение частоты запросов ---
# Сколько попыток входа разрешено с одного адреса (и на один e-mail)
# за окно LOGIN_WINDOW_MINUTES. Считаются только неудачные попытки:
# успешный вход счётчик обнуляет, и работающий администратор
# сам себя не заблокирует.
# Боевое значение: 10 попыток за 5 минут.
LOGIN_MAX_ATTEMPTS=
LOGIN_WINDOW_MINUTES=
# То же для регистрации: сколько аккаунтов можно завести с одного адреса.
# Здесь считаются все попытки — массовая регистрация и есть то, что нужно
# остановить. Боевое значение: 10 за час.
REGISTER_MAX_ATTEMPTS=
REGISTER_WINDOW_MINUTES=
# Доверять ли заголовку X-Forwarded-For при определении адреса клиента.
# true — только если перед сервисом действительно стоит свой обратный
# прокси. Без него заголовок подделывается, и ограничение обходится
# подстановкой нового адреса на каждый запрос.
TRUST_PROXY=

# --- адрес сайта ---
# Из него собирается ссылка восстановления. Заголовок Host из запроса
# для этого не годится: он подделывается.
APP_URL=

# --- демонстрационные аккаунты (только для `npm run seed`, в проде не работает) ---
# Паролей демонстрационных аккаунтов нет в коде: там, где они записаны
# в исходниках, они остаются рабочими паролями на каждой машине,
# где эту команду когда-нибудь выполняли.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MASTER_PASSWORD=
SEED_CLIENT_PASSWORD=

# --- журналирование ---
# error | warn | info | debug
LOG_LEVEL=
