# Пример переменных окружения сервиса «Ноготочки».
# Скопируйте в .env и подставьте свои значения: cp .env.example .env
# Сам .env в репозиторий не попадает — он перечислен в .gitignore.
#
# Здесь только то, что зависит от машины и то, что является секретом.
# Правила работы студии (длительность резерва, горизонт записи, часовой пояс)
# живут в таблице settings и меняются администратором, а не здесь.

# --- окружение ---
# development | production
NODE_ENV=
# Порт HTTP-сервера
PORT=

# --- база данных ---
# Путь к файлу SQLite относительно папки server/
DATABASE_FILE=
# Куда складывать резервные копии базы (VACUUM INTO по расписанию)
DATABASE_BACKUP_DIR=

# --- безопасность ---
# Секрет для подписи токенов сессии. Длинная случайная строка.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Сколько часов живёт сессия до повторного входа
SESSION_TTL_HOURS=
# Дополнительный секрет, подмешиваемый к паролю перед хешированием.
# Хранится только здесь, не в базе: утечка базы без него бесполезна.
PASSWORD_PEPPER=
# Сколько минут живёт ссылка восстановления пароля
PASSWORD_RESET_TTL_MINUTES=

# --- адрес сайта ---
# Из него собирается ссылка восстановления. Заголовок Host из запроса
# для этого не годится: он подделывается.
APP_URL=

# --- начальный администратор (используется только командой npm run seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- журналирование ---
# error | warn | info | debug
LOG_LEVEL=
